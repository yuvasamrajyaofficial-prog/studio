rules_version = '2';

/**
 * MALOLA - Firestore Security Rules
 * Comprehensive rules for all application features
 * Last updated: 2026-07-26
 */

service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================
    // HELPER FUNCTIONS
    // ============================================

    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }

    function isAdminUser() {
      return isSignedIn() && (
        request.auth.token.email.lower() in [
          'prashantbhiremath13@gmail.com',
          'ph293815@gmail.com'
        ]
      );
    }

    function hasRequiredFields(data, fields) {
      return fields.toSet().difference(data.keys().toSet()).size() == 0;
    }

    function isValidSize(data, maxSize) {
      return request.resource.size() < maxSize;
    }

    // ============================================
    // USER PROFILES
    // ============================================

    match /users/{userId} {
      allow get: if isOwner(userId) || isAdminUser();
      allow list: if isAdminUser();
      
      allow create: if isOwner(userId) 
        && hasRequiredFields(request.resource.data, ['uid', 'email'])
        && request.resource.data.uid == userId
        && isValidSize(request.resource.data, 500000);
      
      allow update: if (isExistingOwner(userId) || isAdminUser())
        && isValidSize(request.resource.data, 500000);
      
      allow delete: if isExistingOwner(userId) || isAdminUser();

      match /likes/{likeId} {
        allow read, write: if isOwner(userId);
      }
    }

    // ============================================
    // COMMUNITY PLATFORM (Posts, Comments, Reports)
    // ============================================

    match /posts/{postId} {
      allow get, list: if true;

      allow create: if isSignedIn()
        && hasRequiredFields(request.resource.data, ['authorId', 'content'])
        && request.resource.data.authorId == request.auth.uid
        && isValidSize(request.resource.data, 100000);

      allow update: if isSignedIn() && (
        (resource.data.authorId == request.auth.uid) ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likesCount', 'commentsCount']))
      );

      allow delete: if resource.data.authorId == request.auth.uid || isAdminUser();

      match /comments/{commentId} {
        allow get, list: if true;
        allow create: if isSignedIn()
          && hasRequiredFields(request.resource.data, ['authorId', 'content'])
          && request.resource.data.authorId == request.auth.uid;
        allow update, delete: if resource.data.authorId == request.auth.uid || isAdminUser();
      }
    }

    match /reports/{reportId} {
      allow create: if isSignedIn();
      allow read, update, delete: if isAdminUser();
    }

    // ============================================
    // SCRIPTURES (PUBLIC CONTENT)
    // ============================================

    match /scriptures/{scriptureId} {
      allow get, list: if true;
      allow write: if isAdminUser();
      
      match /chapters/{chapterId} {
        allow get, list: if true;
        allow write: if isAdminUser();
        
        match /verses/{verseId} {
          allow get, list: if true;
          allow write: if isAdminUser();
        }
      }
    }

    // ============================================
    // BLOGS & ARTICLES
    // ============================================

    match /blogs/{blogId} {
      allow get, list: if true;
      allow write: if isAdminUser();
    }

    // ============================================
    // DAILY WISDOM & SADHANAS
    // ============================================

    match /wisdom/{wisdomId} {
      allow get, list: if true;
      allow write: if isAdminUser();
    }

    match /dailyWisdom/{wisdomId} {
      allow get, list: if true;
      allow write: if isAdminUser();
    }

    // ============================================
    // SYSTEM CONFIGURATION
    // ============================================

    match /system_config/{configId} {
      allow get, list: if true;
      allow write: if isAdminUser();
    }

    match /appConfig/{configId} {
      allow get, list: if true;
      allow write: if isAdminUser();
    }

    // ============================================
    // MEDIA VAULT
    // ============================================

    match /media/{mediaId} {
      allow read, list: if true;
      allow write: if isAdminUser();
    }

    // ============================================
    // AI SETTINGS (USER API KEYS)
    // ============================================

    match /aiSettings/{userId} {
      allow get: if isOwner(userId);
      allow list: if false; 
      allow write: if isOwner(userId);
    }

    // ============================================
    // FALLBACK RULE
    // ============================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
